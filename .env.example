# 손님 대화(LLM)를 켤 때 서버 환경변수(또는 .env.local)에 설정.
# 프론트로는 절대 노출되지 않는다(서버리스 함수에서만 사용).
# 채점(judge)은 결정적 코드(scoreCake)라 키가 필요 없다.

OPENAI_API_KEY=sk-...            # 없으면 자동으로 mock 대화
# OPENAI_MODEL=gpt-4o-mini       # 모델 교체
# ANTHROPIC_API_KEY=sk-ant-...   # OpenAI 대신 Anthropic 을 쓸 때
# ANTHROPIC_MODEL=claude-sonnet-5
# MOCK_CHAT=1                     # 키가 있어도 강제로 mock 대화를 쓰고 싶을 때
